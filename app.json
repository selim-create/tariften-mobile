{
  "expo": {
    "name": "Tariften",
    "slug": "tariften-mobile",
    "scheme": "tariften",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tariften.app",
      "buildNumber": "2",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Profil fotoğrafı ve tarif fotoğrafları çekmek için kamera erişimi gereklidir.",
        "NSPhotoLibraryUsageDescription": "Profil fotoğrafı ve tarif fotoğrafları seçmek için galeri erişimi gereklidir.",
        "NSMicrophoneUsageDescription": "Pişirme rehberinde eller serbest sesli komutları algılamak için mikrofon erişimi gereklidir.",
        "NSSpeechRecognitionUsageDescription": "Pişirme rehberinde konuşulan Türkçe komutları tanımak için konuşma tanıma erişimi gereklidir.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "associatedDomains": [
        "applinks:tariften.com",
        "applinks:www.tariften.com"
      ]
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#D84C40",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tariften.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tariften.com",
              "pathPrefix": "/rehber"
            },
            {
              "scheme": "https",
              "host": "www.tariften.com",
              "pathPrefix": "/rehber"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Pişirme rehberinde eller serbest sesli komutları algılamak için mikrofon erişimi gereklidir.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Tariften pişirme rehberinde eller serbest sesli komutlar için mikrofon erişimi gereklidir.",
          "speechRecognitionPermission": "Tariften pişirme rehberinde sonraki, önceki ve oku komutlarını algılamak için konuşma tanıma izni gereklidir."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fcfbf9"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#db4c3f",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "Tariften'e Aktar",
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "775efa67-ee9e-45a1-8c43-0afec950d009"
      }
    }
  }
}
