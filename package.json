{
  "name": "tariften-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "ios:sim": "APP_VARIANT=development NODE_OPTIONS=--dns-result-order=ipv4first expo start --clear --localhost --port 8081 --dev-client",
    "ios:sim:install": "bash scripts/ios-simulator-local-build.sh",
    "ios:sim:open": "xcrun simctl openurl booted 'tariften-dev://expo-development-client/?url=http%3A%2F%2F127.0.0.1%3A8081'",
    "check:types": "tsc --noEmit",
    "check:expo": "expo install --check",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~55.0.31",
    "expo-apple-authentication": "~55.0.17",
    "expo-audio": "~55.0.18",
    "expo-auth-session": "~55.0.18",
    "expo-constants": "~55.0.7",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.0",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-speech": "~55.0.18",
    "expo-speech-recognition": "~3.1.1",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true
}
